# ─── Supabase (Cloud) ────────────────────────────────────────────────
# Project: xxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Site URL ────────────────────────────────────────────────────────
# Used by email templates to build absolute links (login, portal, reports).
# In dev, point to localhost so test emails open the dev server.
NEXT_PUBLIC_SITE_URL=https://tableturnerr.com

# PostHog browser analytics. The project token is public; never expose a personal API key.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_DEBUG=false
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Change to https://www.tableturnerr.com/ingest after the Cloudflare proxy is live.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Unified Auth / Cross-Subdomain SSO ──────────────────────────────
# All three vars below are PROD-ONLY. Leave unset in dev so cookies stay
# host-scoped to localhost and there's no host gate or redirect dance.
#
# Cookie domain — set to ".tableturnerr.com" so the Supabase auth cookie
# is readable by every subdomain (tableturnerr.com, auth.*, wireframes.*).
NEXT_PUBLIC_COOKIE_DOMAIN=.tableturnerr.com
# The host this Next.js app serves as the "main app" — used to bounce
# non-auth paths off auth.tableturnerr.com back to here.
NEXT_PUBLIC_APP_HOST=tableturnerr.com
NEXT_PUBLIC_APP_URL=https://tableturnerr.com
# The host this Next.js app serves as the central auth surface (only
# /login + /api/auth/callback). Same Vercel project, second domain alias.
NEXT_PUBLIC_AUTH_HOST=auth.tableturnerr.com
# Allowlist of external origins the auth callback is allowed to redirect
# back to after sign-in (comma-separated). Required for the wireframes
# handoff. Add any future sub-apps here.
NEXT_PUBLIC_ALLOWED_RETURN_ORIGINS=https://wireframes.tableturnerr.com
# Optional: link shown in the admin sidebar to jump to the wireframes
# tool. If unset, the link is hidden.
NEXT_PUBLIC_WIREFRAMES_URL=https://wireframes.tableturnerr.com

# ─── Cloudflare Turnstile (bot protection on ingest API) ─────────────
# Server-side secret used to verify the token sent from client sites.
# Cloudflare dashboard → Turnstile → site → Secret key. If unset, the
# ingest API logs a warning and skips verification (dev-only).
# Test secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Resend (transactional email) ────────────────────────────────────
# Used for "TableTurnerr shared a report with you" and "Your monthly
# report is ready" emails. Get the key at https://resend.com → API Keys.
# The sender address must be on a domain you've verified in Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=xxxxxxx@tableturnerr.com
EMAIL_FROM_NAME=Name

# ─── GoHighLevel (internal CRM) ──────────────────────────────────────
# Site leads from the contact/trial form are pushed here in addition to
# Supabase contact_leads. Create a GHL Workflow with an "Inbound Webhook"
# trigger and paste its URL here. Leave unset to skip the push (e.g. local dev).
GHL_LEAD_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/xxxxxxxx/webhook-trigger/xxxxxxxx

# ─── Cron auth (uptime poller + scheduled-post publisher) ────────────
# Bearer secret for /api/cron/*. Vercel sends this automatically on scheduled
# cron GETs when set in project env; an external scheduler must send
# `Authorization: Bearer <CRON_SECRET>`. If unset, the cron routes return 503.
CRON_SECRET=

# ─── Telemetry ingest (centralized logging + uptime heartbeats) ──────
# Bearer token that every monitored tool (bridge, discord-bot, insta-agent,
# etc.) presents to POST /api/telemetry/logs and /heartbeat. Use one long
# random string and set the SAME value as TELEMETRY_TOKEN on each tool.
TELEMETRY_INGEST_TOKEN=

# ─── Alerting (Status dashboard → Discord + email) ───────────────────
# Fired on service up/down transitions and error-log spikes. Each channel is
# optional: an unset one is skipped.
# Discord channel webhook (Server Settings → Integrations → Webhooks).
DISCORD_ALERT_WEBHOOK_URL=
# Comma-separated recipients for alert emails (sent via Resend above).
ALERT_EMAIL_TO=
# Optional tuning (defaults shown):
# ALERT_MIN_INTERVAL_SEC=300   # flap-damping between same-target alerts
# LOG_SPIKE_WINDOW_MIN=10      # error/fatal counting window
# LOG_SPIKE_THRESHOLD=10       # errors in the window that trip a spike alert
# UPTIME_DEGRADED_LATENCY_MS=1500  # fallback slow-but-up threshold
